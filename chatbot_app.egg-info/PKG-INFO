│  │  └─ service/
│  │     ├─ __init__.py
│  │     ├─ client_factory.py     # provider-client factory and common response contract
│  │     ├─ openai_client.py      # OpenAI adapter
│  │     └─ gemini_client.py      # Gemini adapter
│  ├─ config/
│  │  ├─ __init__.py
